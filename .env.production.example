# BizFlow HRIS production environment template.
# NEVER commit real credentials or customer data.
DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

DB_ENGINE=postgresql
POSTGRES_DB=bizflow
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
POSTGRES_CONN_MAX_AGE=60

# Shared cache/session + login throttling. Use managed Redis/Valkey.
REDIS_URL=redis://:password@host:6379/0

# Private S3-compatible object storage for HR documents and attendance proof.
DJANGO_STORAGE=s3
BIZFLOW_STORAGE_KEY=
BIZFLOW_STORAGE_SECRET=
BIZFLOW_STORAGE_BUCKET=
BIZFLOW_STORAGE_ENDPOINT=
BIZFLOW_STORAGE_REGION=
BIZFLOW_STORAGE_ADDRESSING=path
BIZFLOW_STORAGE_SIGNATURE=s3v4
BIZFLOW_STORAGE_URL_TTL=300

# PayMongo live credentials and plan IDs.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_LIVEMODE=True
PAYMONGO_PLAN_STARTER=
PAYMONGO_PLAN_GROWTH=
PAYMONGO_PLAN_BUSINESS=
